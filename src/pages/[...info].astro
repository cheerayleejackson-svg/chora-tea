---
import Base from '../layouts/Base.astro'
import { infoPages, type InfoPage } from '../data/info-pages'
export function getStaticPaths() { return infoPages.map(page => ({ params: { info: page.slug }, props: { page } })) }
interface Props { page: InfoPage }
const { page } = Astro.props
const base = import.meta.env.BASE_URL
---
<Base title={`${page.title} — Chora Tea`}>
  <article class="info-page">
    <a class="back-link" href={base}>Chora Tea home</a>
    <header><h1>{page.title}</h1><p class="intro">{page.intro}</p></header>
    <div class="info-body">
      {page.sections.map(section => <section><h2>{section.title}</h2><p>{section.text}</p></section>)}
      <nav class="related-links" aria-label={`Explore ${page.title}`}>
        {page.links.map(link => <a href={`${base}${link.href}`}>{link.label}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a>)}
      </nav>
    </div>
  </article>
</Base>
<style>
  .info-page { max-width:850px; margin:0 auto; padding:40px 0; }
  .back-link { color:var(--ink-soft); font-size:13px; text-underline-offset:4px; }
  header { margin:32px 0 40px; border-bottom:1px solid var(--line); padding-bottom:28px; }
  h1 { font-size:clamp(38px,5vw,64px); line-height:1.12; margin:0 0 20px; }
  .intro { font-size:20px; color:var(--ink-soft); }
  .info-body { max-width:70ch; }
  section { margin:0 0 36px; }
  h2 { font-size:27px; line-height:1.25; margin:0 0 14px; }
  section p { color:var(--ink-soft); line-height:1.85; }
  .related-links { margin-top:40px; border-top:1px solid var(--line); }
  .related-links a { display:flex; align-items:center; justify-content:space-between; gap:20px; min-height:60px; padding:18px 0; border-bottom:1px solid var(--line); text-decoration:none; }
  .related-links a:hover { color:var(--seal); }
  svg { flex-shrink:0; }
</style>
