---
import BrandLogo from './BrandLogo.astro'
import SiteMenu from './SiteMenu.astro'
import CartButton from './CartButton.tsx'
const base = import.meta.env.BASE_URL
---
<header class="nav">
  <div class="nav-left"><SiteMenu /></div>
  <a class="brand" href={base} aria-label="Chora Tea home">
    <BrandLogo size={54} />
    <span class="wordmark">Chora Tea</span>
  </a>
  <nav class="links" aria-label="Main navigation">
    <a class="account-link" href={`${base}account`} aria-label="My Account" title="My Account"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 22v-2a8 8 0 0 1 16 0v2"/></svg></a>
    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Dark mode" aria-pressed="false" title="Switch to dark mode" hidden>
      <svg class="moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 13.1A8.6 8.6 0 0 1 10.9 3.5 8.6 8.6 0 1 0 20.5 13.1Z" /></svg>
      <svg class="sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
    </button>
    <CartButton client:load />
  </nav>
</header>
<style>
  .nav { position:relative; display:grid; grid-template-columns:1fr auto 1fr; align-items:center; padding:16px 0; border-bottom:1px solid var(--line); }
  .brand { display:flex; flex-direction:column; align-items:center; gap:4px; text-decoration:none; }
  .wordmark { font-family: var(--font-display); font-size:19px; font-weight:500; }
  .nav-left { justify-self:start; }
  .links { display:flex; align-items:center; justify-self:end; gap:10px; }
  .account-link { display:grid; place-items:center; width:44px; height:44px; }
  .links a { text-decoration:none; font-weight:500; }
  @media (max-width: 520px) {
    .wordmark { display:none; }
    .links { gap:0; }
    .account-link { display:none; }
  }
</style>
