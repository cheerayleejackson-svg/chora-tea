---
interface Props {
  size?: number
  alt?: string
}

const { size = 48, alt = '' } = Astro.props
const base = import.meta.env.BASE_URL
---
<img
  class="brand-logo"
  src={`${base}chora-tea-logo.svg`}
  width={size}
  height={size}
  alt={alt}
  style={`--logo-size: ${size}px`}
/>

<style>
  .brand-logo {
    width: var(--logo-size);
    height: var(--logo-size);
    flex: 0 0 auto;
    object-fit: contain;
  }
</style>
